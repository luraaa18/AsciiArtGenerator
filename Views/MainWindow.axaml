<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AsciiArtApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="AsciiArtApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="ASCII Art Generator"
        Width="900" Height="700"
        MinWidth="700" MinHeight="500">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E1E2E" Padding="20,15">
            <StackPanel>
                <TextBlock Text="ASCII Art Generator"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#CDD6F4"/>
                <TextBlock Text="Transform text and images into ASCII art"
                           FontSize="13" Foreground="#A6ADC8"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <TabControl Margin="10">
            <TabItem Header="Text → ASCII">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="10">

                    <StackPanel Grid.Row="0" Spacing="5">
                        <TextBlock Text="Type your text:" FontWeight="Bold"/>
                        <TextBox Text="{Binding InputText}"
                                 Watermark="Hello World"
                                 Padding="10,8"
                                 FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="5" Margin="0,15,0,0">
                        <TextBlock Text="Choose font style:" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding AvailableFonts}"
                                  SelectedItem="{Binding SelectedFont}"
                                  Padding="10,8"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="Generate ASCII"
                            Command="{Binding GenerateTextAsciiCommand}"
                            Background="#89B4FA" Foreground="#1E1E2E"
                            FontWeight="Bold"
                            Padding="20,10"
                            Margin="0,15,0,15"
                            HorizontalAlignment="Left"/>

                    <Border Grid.Row="3"
                            Background="#1E1E2E"
                            BorderBrush="#45475A"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding TextAsciiOutput}"
                                       FontFamily="Consolas, Courier New, monospace"
                                       FontSize="12"
                                       Foreground="#CDD6F4"
                                       TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                        <Button Content="📋 Copy to Clipboard"
                                Command="{Binding CopyTextAsciiCommand}"
                                Padding="15,8"/>
                        <Button Content="💾 Save as .txt"
                                Command="{Binding SaveTextAsciiCommand}"
                                Padding="15,8"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   VerticalAlignment="Center"
                                   Foreground="#A6E3A1"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                </Grid>
            </TabItem>

            <TabItem Header="Image → ASCII">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="10">

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                        <Button Content="📂 Load Image"
                                Command="{Binding LoadImageCommand}"
                                Background="#89B4FA" Foreground="#1E1E2E"
                                FontWeight="Bold"
                                Padding="15,8"/>
                        <TextBlock Text="{Binding LoadedImageName}"
                                   VerticalAlignment="Center"
                                   Foreground="#A6ADC8"
                                   FontStyle="Italic"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*,Auto" Margin="0,15,0,0">
                        <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                            <TextBlock>
                                <Run Text="Output width: "/>
                                <Run Text="{Binding OutputWidth}" FontWeight="Bold"/>
                                <Run Text=" chars"/>
                            </TextBlock>
                            <Slider Minimum="40" Maximum="200" Value="{Binding OutputWidth}"
                                    TickFrequency="10" IsSnapToTickEnabled="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,10,0">
                            <TextBlock Text="Character set:"/>
                            <ComboBox ItemsSource="{Binding AvailableCharSets}"
                                      SelectedItem="{Binding SelectedCharSet}"
                                      HorizontalAlignment="Stretch"
                                      Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Bottom">
                            <CheckBox Content="🎨 Color mode"
                                      IsChecked="{Binding UseColor}"
                                      FontWeight="Bold"/>
                            <CheckBox Content="Invert"
                                      IsChecked="{Binding InvertColors}"/>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="2"
                            Content="Generate ASCII Art"
                            Command="{Binding GenerateImageAsciiCommand}"
                            Background="#A6E3A1" Foreground="#1E1E2E"
                            FontWeight="Bold"
                            Padding="20,10"
                            Margin="0,15,0,15"
                            HorizontalAlignment="Left"/>

                    <Border Grid.Row="3"
                            Background="#1E1E2E"
                            BorderBrush="#45475A"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Panel>
                                <SelectableTextBlock Text="{Binding ImageAsciiOutput}"
                                                      FontFamily="Consolas, Courier New, monospace"
                                                      FontSize="8"
                                                      Foreground="#CDD6F4"
                                                      TextWrapping="NoWrap"
                                                      IsVisible="{Binding !UseColor}"/>
                                <Image Source="{Binding ColoredImageBitmap}"
                                       IsVisible="{Binding UseColor}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"/>
                            </Panel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                        <Button Content="📋 Copy to Clipboard"
                                Command="{Binding CopyImageAsciiCommand}"
                                Padding="15,8"/>
                        <Button Content="💾 Save as .txt"
                                Command="{Binding SaveImageAsciiCommand}"
                                Padding="15,8"/>
                        <TextBlock Text="{Binding ImageStatusMessage}"
                                   VerticalAlignment="Center"
                                   Foreground="#A6E3A1"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>